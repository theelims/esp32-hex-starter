# Project-wide sdkconfig overrides. PlatformIO picks these up at build time.
# Derived from ESP32-S3-WROOM-1-N16R8 (default module).

# C++ exceptions off, RTTI off (standard embedded policy — override if needed).
# Implication: std::variant/std::get throwing is undefined; Result<T,E> callers
# MUST check is_ok()/is_err() before value()/error(). See CLAUDE.md.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# Flash size (derived from module_part_number=ESP32-S3-WROOM-1-N16R8)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM: octal, 80MHz (8MB)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# CPU frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Partition table — always custom. Built-in tables (SINGLE_APP, TWO_OTA)
# assume 4 MB flash and waste anything beyond that. The custom CSV is
# scaffolded from partition_scheme=default.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# USB-JTAG/Serial as console (so logs appear over the single USB-C cable)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Log level — info by default, app code can override per module
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# FreeRTOS tick 1000 Hz
CONFIG_FREERTOS_HZ=1000

# Stack check, watchpoints — helps agent diagnose crashes
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# Coredump to flash. Enables post-mortem backtrace extraction with
# espcoredump.py; the `gdb-diagnose` sub-agent relies on this.
CONFIG_ESP_COREDUMP_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
